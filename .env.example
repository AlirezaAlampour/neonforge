# =============================================================================
# DGX Spark AI Stack — Environment Configuration
# Copy to .env and adjust values before running docker compose up
# =============================================================================

# --- Host paths (bind mounts) ------------------------------------------------
MODELS_DIR=/srv/ai/models
HF_CACHE_DIR=/srv/ai/cache/hf
OUTPUTS_DIR=/srv/ai/outputs
ASSETS_DIR=/srv/ai/assets
LOGS_DIR=/srv/ai/logs

# --- GPU / CUDA ---------------------------------------------------------------
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# --- Networking ---------------------------------------------------------------
# Loopback is the safe default. Use a specific LAN/Tailscale address to expose the UI remotely.
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
FRONTEND_PORT=3000
REDIS_PORT=6379

# --- Shared Video / Character runtime ----------------------------------------
COMFYUI_IDLE_TIMEOUT=300

# --- Faster-Whisper -----------------------------------------------------------
WHISPER_MODEL_SIZE=medium
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5

# --- F5-TTS ------------------------------------------------------------------
F5TTS_IDLE_TIMEOUT=900
FISH_SPEECH_IDLE_TIMEOUT=900
MISOTTS_IDLE_TIMEOUT=900
BREEZE_TTS_IDLE_TIMEOUT=900
VOXCPM2_IDLE_TIMEOUT=900
F5TTS_SAMPLE_RATE=24000
# Optional local voiceover models. Disabled by default and require separate model containers.
FISH_SPEECH_ENABLED=false
FISH_SPEECH_INTERNAL_URL=http://fish_speech:8000
TTS_PROVIDER=misotts
MISOTTS_INTERNAL_URL=http://misotts:8000
MISOTTS_MODEL_ID=MisoLabs/MisoTTS
MISOTTS_DEVICE=auto
MISOTTS_MAX_AUDIO_MS=10000
MISOTTS_ENABLE_VOICE_PROMPT=true
MISOTTS_CHECKOUT_DIR=/opt/misotts-src
MISOTTS_MIN_CUDA_FREE_GB=12
BREEZE_TTS_ENABLED=false
BREEZE_TTS_INTERNAL_URL=http://breeze_tts:8000
BREEZE_TTS_MODEL_ID=BreezeBlue/Breeze-TTS-2
BREEZE_TTS_MODEL_PATH=/models/breeze_tts/Breeze-TTS-2
BREEZE_TTS_AUTO_DOWNLOAD=true
BREEZE_TTS_SOURCE_REV=008f769016b0a24711becd7a4925030bc93f608c
VOXCPM2_ENABLED=false
VOXCPM2_INTERNAL_URL=http://voxcpm2:8000
VOXCPM2_MODEL_PATH=/models/voxcpm2/openbmb/VoxCPM2

# --- Lip Sync (LatentSync 1.6) -----------------------------------------------
LIPSYNC_IDLE_TIMEOUT=300
LIPSYNC_BACKEND=LatentSync 1.6
LATENTSYNC_TIMEOUT_SEC=1800

# --- Supervisor -------------------------------------------------------------
IDLE_SCAN_INTERVAL=15
MEMORY_RECLAIM_TIMEOUT=90

# --- Memory Safety (UMA) -----------------------------------------------------
# Percentage thresholds
MEMORY_WARN_THRESHOLD=70
MEMORY_HARD_LIMIT=80

# Per-tier memory reservations: minimum GB that must remain available
# before a job of that tier is admitted.
# Heavy models use backend/workflow-specific launch minimums in the supervisor.
MEM_RESERVE_HEAVY_GB=40
# Medium (tts, lipsync): needs ~10 GB free
MEM_RESERVE_MEDIUM_GB=10
# Light (whisper): needs ~2 GB free
MEM_RESERVE_LIGHT_GB=2

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
