[Unit]
Description=Proxy private NeonForge connections to existing H3 loopback
Requires=neonforge-h3-bridge.socket
After=neonforge-h3-bridge.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=10min 127.0.0.1:8189
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_UNIX
